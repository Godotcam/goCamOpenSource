# Copy to .env.docker, generate independent secrets, then set the public hostname.
# openssl rand -hex 16 -> 32 ASCII bytes for ENCRYPTION_KEY (not hex-decoded).
# openssl rand -hex 32 -> SESSION_SECRET.
ENCRYPTION_KEY=
SESSION_SECRET=
HTTP_SERVER_HOST=verify.example.com
HTTP_SERVER_PROTOCOL=https
# Exactly one trusted reverse proxy; never expose the container port to clients.
TRUST_PROXY=1
GOCAM_PORT=3300
GOCAM_IMAGE=gocam:production
